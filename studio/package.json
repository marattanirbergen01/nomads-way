{
  "name": "nomads-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --import tsx src/server/index.ts",
    "import": "tsx src/server/cli/import.ts",
    "user": "tsx src/server/cli/user.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
